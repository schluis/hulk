#!/usr/bin/env python3
"""Capture distinct ball-filter scenarios, then search using training data only."""
import argparse
import concurrent.futures
import hashlib
import json
import pathlib
import subprocess

ROOT = pathlib.Path(__file__).resolve().parent.parent
FAMILIES = [
    ("stationary-close", 0, 0.44),
    ("approach", 0, 0.44),
    ("fast-crossing", 0, 0.44),
    ("brief-gaps", 0, 0.44),
    ("contested", 2, 0.44),
    ("long-occlusion", 1, 0.75),
    ("empty-false", 0, 0.44),
    ("sideline", 1, 0.44),
]


def save(path, value):
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(json.dumps(value, indent=2) + "\n")
    temporary.replace(path)


def capture(args):
    args.output.mkdir(parents=True, exist_ok=False)
    manifest = {"families": [], "complete": False}
    for index, (family, opponents, width) in enumerate(FAMILIES):
        destination = args.output / family
        command = [
            str(args.binary), "--capture-ball-tuning", str(destination),
            "--capture-ball-scenario", str(ROOT / "tools/simulate/scenarios/ball-filter" / (family + ".json")),
            "--capture-ball-seed-offset", str(args.seed + index * 10000),
            "--tuning-opponents", str(opponents), "--tuning-opponent-width", str(width),
        ]
        with (args.output / (family + ".log")).open("w") as log:
            subprocess.run(command, cwd=ROOT, stdout=log, stderr=subprocess.STDOUT, check=True)
        entry = {
            "family": family, "command": command,
            "training": [str(destination / f"train-{seed}.mcap") for seed in (42, 43)],
            "validation": [str(destination / "validation-4243.mcap")],
            "parameters": str(destination / "baseline.json5"),
        }
        entry["sha256"] = {
            path: hashlib.sha256(pathlib.Path(path).read_bytes()).hexdigest()
            for path in entry["training"] + entry["validation"] + [entry["parameters"]]
        }
        manifest["families"].append(entry)
        save(args.output / "suite.json", manifest)
    manifest["complete"] = True
    save(args.output / "suite.json", manifest)


def search(args):
    manifest = json.loads(args.suite.read_text())
    if not manifest.get("complete") or len(manifest["families"]) != 8:
        raise ValueError("Require eight completed, coverage-checked scenario families")
    families = manifest["families"]
    baseline = pathlib.Path(families[0]["parameters"])
    parameters = json.loads(baseline.read_text())
    for family in families:
        if json.loads(pathlib.Path(family["parameters"]).read_text()) != parameters:
            raise ValueError("Capture parameters differ across families")
        for path, expected in family["sha256"].items():
            if hashlib.sha256(pathlib.Path(path).read_bytes()).hexdigest() != expected:
                raise ValueError(f"Capture changed: {path}")
    args.output.mkdir(parents=True, exist_ok=False)
    train = [path for family in families for path in family["training"]]
    validation = [path for family in families for path in family["validation"]]

    def worker(index):
        destination = args.output / f"worker-{index:02}"
        command = [
            str(args.binary), "--train", *train, "--validation", *validation,
            "--parameters", str(baseline), "--trials", str(args.trials),
            "--seed", str(args.seed + index * 1000003), "--search-method", args.method,
            "--output", str(destination),
        ]
        if args.initial_parameters:
            command += ["--initial-parameters", str(args.initial_parameters)]
        with (args.output / f"worker-{index:02}.log").open("w") as log:
            subprocess.run(command, cwd=ROOT, stdout=log, stderr=subprocess.STDOUT, check=True)
        report = json.loads((destination / "report.json").read_text())
        return report["training"]["optimized"]["loss"], str(destination / "report.json")

    with concurrent.futures.ThreadPoolExecutor(max_workers=args.workers) as pool:
        results = list(pool.map(worker, range(args.workers)))
    loss, report = min(results)
    save(args.output / "selected.json", {"training_loss": loss, "report": report,
         "selection": "training only; inspect all per-family and held-out metrics before promotion"})


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="operation", required=True)
    for operation in ("capture", "search"):
        command = sub.add_parser(operation)
        command.add_argument("--binary", type=lambda p: pathlib.Path(p).resolve(), required=True)
        command.add_argument("--output", type=lambda p: pathlib.Path(p).resolve(), required=True)
        command.add_argument("--seed", type=int, default=410000)
        if operation == "search":
            command.add_argument("--suite", type=pathlib.Path, required=True)
            command.add_argument("--workers", type=int, default=32)
            command.add_argument("--trials", type=int, default=4096)
            command.add_argument("--method", choices=("coordinate", "differential-evolution"), default="coordinate")
            command.add_argument("--initial-parameters", type=lambda p: pathlib.Path(p).resolve())
    args = parser.parse_args()
    if args.seed < 0 or (args.operation == "search" and (args.workers < 1 or args.trials < 1)):
        parser.error("seed must be nonnegative; workers and trials must be positive")
    (capture if args.operation == "capture" else search)(args)


if __name__ == "__main__":
    main()
